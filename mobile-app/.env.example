# Optional. Baize tries providers in this order, then falls back to local offline replies.
# Recommended low-cost test order: Groq first, Gemini for vision/cards, then NVIDIA/GitHub/OpenRouter.
AI_PROVIDER_ORDER="gemini,groq,nvidia,github,openrouter"

# Optional. Groq free plan. Good for fast chat.
GROQ_API_KEY="MY_GROQ_API_KEY"
GROQ_MODEL="llama-3.3-70b-versatile"

# Optional. Gemini free tier. Good for chat and learning-card generation.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.0-flash"

# Optional. NVIDIA Build / NIM free endpoints.
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"
NVIDIA_MODEL="nvidia/llama-3.1-nemotron-nano-8b-v1"

# Optional. GitHub Models. You can use a GitHub Models key or a compatible GitHub token.
GITHUB_MODELS_API_KEY="MY_GITHUB_MODELS_API_KEY"
GITHUB_MODELS_MODEL="openai/gpt-4.1-mini"

# Optional. OpenRouter free models. Free model names can change, so update this from OpenRouter's model page.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
OPENROUTER_MODEL="deepseek/deepseek-r1-0528:free"

# Optional. Public URL after deployment.
APP_URL="MY_APP_URL"
